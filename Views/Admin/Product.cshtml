@model IEnumerable<ShopSphere.Models.Product>

<div class="d-flex
    justify-content-between
    align-items-center
    mt-4
    mb-4">

    <h1 class="fw-bold">

        Admin Products

    </h1>

    <a asp-controller="Product"
       asp-action="Create"
       class="btn btn-primary">

        Add Product

    </a>

</div>

<div class="card shadow border-0 p-4">

    <table class="table align-middle">

        <thead>

            <tr>

                <th>
                    Image
                </th>

                <th>
                    Product
                </th>

                <th>
                    Seller
                </th>

                <th>
                    Price
                </th>

                <th>
                    Status
                </th>

                <th>
                    Actions
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td width="120">

                        <img src="@item.ImageUrl"
                             class="img-fluid rounded"
                             style="height:80px;
                        width:80px;
                        object-fit:cover;" />

                    </td>

                    <td>

                        <h5 class="fw-bold">

                            @item.Name

                        </h5>

                        <small class="text-muted">

                            @item.Description

                        </small>

                    </td>

                    <td>

                        <span class="badge bg-success">

                            @item.SellerName

                        </span>

                    </td>

                    <td>

                        <span class="fw-bold text-primary">

                            Rs. @item.Price

                        </span>

                    </td>

                    <td>

                        @if (item.IsApproved)
                        {
                            <span class="badge bg-success">

                                Approved

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">

                                Pending

                            </span>
                        }

                    </td>

                    <td>

                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">

                            View

                        </a>

                        <a asp-controller="Product"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">

                            Delete

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>