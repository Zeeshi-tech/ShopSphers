@model IEnumerable<ShopSphere.Models.Order>
<div class="mt-3">
    <h4 class="fw-bold mb-4"><i class="fa fa-tachometer-alt me-2" style="color:#f85606;"></i>Admin Dashboard</h4>
    <div class="row g-3 mb-4">
        <div class="col-md-2 col-6"><div class="stat-card"><div class="stat-num">@ViewBag.TotalProducts</div><div class="stat-lbl">Products</div></div></div>
        <div class="col-md-2 col-6"><div class="stat-card" style="border-color:#28a745;"><div class="stat-num" style="color:#28a745;">@ViewBag.TotalOrders</div><div class="stat-lbl">Orders</div></div></div>
        <div class="col-md-2 col-6"><div class="stat-card" style="border-color:#007bff;"><div class="stat-num" style="color:#007bff;">@ViewBag.TotalUsers</div><div class="stat-lbl">Users</div></div></div>
        <div class="col-md-2 col-6"><div class="stat-card" style="border-color:#ffc107;"><div class="stat-num" style="color:#ffc107;">@ViewBag.PendingOrders</div><div class="stat-lbl">Pending</div></div></div>
        <div class="col-md-4"><div class="stat-card" style="border-color:#c00;"><div class="stat-num" style="color:#c00;font-size:20px;">Rs.@(((decimal?)ViewBag.TotalRevenue ?? 0).ToString("N0"))</div><div class="stat-lbl">Total Revenue</div></div></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><a asp-action="Products" class="btn btn-warning w-100 fw-bold py-3"><i class="fa fa-box me-1"></i>Products Manage Karo</a></div>
        <div class="col-md-3"><a asp-action="Orders" class="btn btn-danger w-100 fw-bold py-3"><i class="fa fa-list me-1"></i>Sab Orders</a></div>
        <div class="col-md-3"><a asp-controller="Product" asp-action="Create" class="btn btn-success w-100 fw-bold py-3"><i class="fa fa-plus me-1"></i>Product Add Karo</a></div>
        <div class="col-md-3"><a asp-action="SellerRequests" class="btn btn-info w-100 fw-bold py-3"><i class="fa fa-users me-1"></i>Seller Requests (@ViewBag.SellerRequests)</a></div>
    </div>
    <div class="white-card">
        <h5 class="fw-bold border-bottom pb-2 mb-3">Latest Orders</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>#</th><th>Customer</th><th>Phone</th><th>Amount</th><th>Payment</th><th>Status</th><th>Date</th><th>Action</th></tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.Id</strong></td>
                            <td>@order.FullName</td>
                            <td>@order.PhoneNumber</td>
                            <td class="text-danger fw-bold">Rs.@order.TotalAmount.ToString("N0")</td>
                            <td><span class="badge bg-secondary">@order.PaymentMethod</span></td>
                            <td><span class="badge b-@order.OrderStatus.ToLower()">@order.OrderStatus</span></td>
                            <td class="text-muted small">@order.OrderDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    @{
                                        var statuses = new[] { "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };
                                        var selectHtml = "<select name='status' class='form-select form-select-sm' style='width:120px;'>";
                                        foreach (var st in statuses)
                                        {
                                            selectHtml += st == order.OrderStatus
                                                ? $"<option value='{st}' selected>{st}</option>"
                                                : $"<option value='{st}'>{st}</option>";
                                        }
                                        selectHtml += "</select>";
                                    }
                                    @Html.Raw(selectHtml)
                                    <button class="btn btn-sm btn-primary">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


