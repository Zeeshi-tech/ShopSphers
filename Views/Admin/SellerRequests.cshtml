@model IEnumerable<ShopSphere.Models.SellerRequest>

<div class="container mt-5">

    <h2 class="fw-bold mb-4">

        Seller Requests

    </h2>

    <table class="table table-bordered">

        <thead class="table-dark">

            <tr>

                <th>Email</th>
                <th>Status</th>
                <th>Action</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>

                        @item.Email

                    </td>

                    <td>

                        @item.Status

                    </td>

                    <td>

                        <a asp-action="ApproveSeller"
                           asp-route-id="@item.Id"
                           class="btn btn-success">

                            Approve

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
