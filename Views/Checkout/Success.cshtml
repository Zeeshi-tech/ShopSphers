@model ShopSphere.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}
<div class="success-card">
    <div class="success-icon">&#9989;</div>
    <h2 class="fw-bold text-success mt-3">Order Placed Successfully!</h2>
    <p class="text-muted">Thank you, @Model?.FullName! Your order has been confirmed.</p>
    @if (Model != null)
    {
        <div class="order-detail-grid mb-4">
            <div class="order-detail-row">
                <span class="fw-bold">Order Number</span>
                <span>@Model.OrderNumber</span>
            </div>
            <div class="order-detail-row"><span class="fw-bold">Payment</span><span>@Model.PaymentMethod</span></div>
            <div class="order-detail-row"><span class="fw-bold">Status</span><span class="badge badge-pending">@Model.OrderStatus</span></div>
            <div class="order-detail-row"><span class="fw-bold">Total Amount</span><span class="text-danger fw-bold">Rs. @Model.TotalAmount.ToString("N0")</span></div>
            <div class="order-detail-row"><span class="fw-bold">Delivery Address</span><span>@Model.Address</span></div>
        </div>
        @if (Model.OrderItems?.Any() == true)
        {
            <h6 class="fw-bold text-start mb-2">Items Ordered</h6>
            @foreach (var item in Model.OrderItems)
            {
                <div class="d-flex justify-content-between border-bottom py-2 text-start">
                    <span>@item.Product?.Name &times; @item.Quantity</span>
                    <span class="fw-bold">Rs. @((item.Price * item.Quantity).ToString("N0"))</span>
                </div>
            }
        }
    }
    <div class="alert alert-warning text-start mt-4">
        <i class="fa fa-truck me-2"></i>
        <strong>Estimated Delivery:</strong> 3&ndash;5 Working Days
    </div>
    <div class="d-flex gap-3 justify-content-center mt-2">
        <a asp-controller="Order" asp-action="MyOrders" class="btn btn-warning fw-bold px-4">
            <i class="fa fa-list me-1"></i>My Orders
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
            Continue Shopping
        </a>
    </div>
</div>
