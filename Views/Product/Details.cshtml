@model ShopSphere.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="row mt-3 g-4">
    <!-- IMAGE -->
    <div class="col-md-4">
        <div class="white-card text-center">
            <img src="@Model.ImageUrl" class="detail-main-img" alt="@Model.Name"
                 onerror="this.src='https://via.placeholder.com/400x400?text=No+Image'" />
        </div>
    </div>

    <!-- DETAILS -->
    <div class="col-md-5">
        <div class="white-card">
            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <a asp-controller="Product" asp-action="Index" asp-route-category="@Model.Category"
                   class="badge bg-warning text-dark mb-2 text-decoration-none">@Model.Category</a>
            }
            <h2 class="fw-bold mb-2">@Model.Name</h2>

            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="p-stars" style="font-size:15px;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="fa fa-star@(i <= (int)Model.Rating ? "" : "-o")"></i>
                    }
                </div>
                <span class="fw-bold">@Model.Rating.ToString("F1")</span>
                <span class="text-muted small">(@Model.Reviews.Count reviews)</span>
            </div>

            <div class="d-flex align-items-baseline gap-3 mb-3">
                <div class="detail-price">Rs. @Model.Price.ToString("N0")</div>
                @if (Model.OriginalPrice > Model.Price)
                {
                    <del class="text-muted fs-5">Rs. @Model.OriginalPrice.ToString("N0")</del>
                    <span class="badge bg-danger fs-6">-@((int)(100 - (Model.Price / Model.OriginalPrice * 100)))% OFF</span>
                }
            </div>

            <div class="mb-3">
                <span class="badge bg-success me-2">@Model.SellerName</span>
                @if (Model.Stock > 10)
                {
                    <span class="badge bg-success">In Stock (@Model.Stock available)</span>
                }
                else if (Model.Stock > 0)
                {
                    <span class="badge bg-warning text-dark">Only @Model.Stock left!</span>
                }
                else
                {
                    <span class="badge bg-danger">Out of Stock</span>
                }
            </div>

            <p class="text-muted mb-4" style="line-height:1.7;">@Model.Description</p>

            @if (Model.Stock > 0)
            {
                <!-- QUANTITY SELECTOR -->
                <div class="mb-3">
                    <label class="fw-semibold small d-block mb-2">Quantity:</label>
                    <div class="qty-box">
                        <button class="qty-btn" type="button" onclick="changeQty(-1)">&#8722;</button>
                        <input id="qtyInput" type="number" value="1" min="1" max="@Model.Stock" class="qty-input form-control" />
                        <button class="qty-btn" type="button" onclick="changeQty(1)">+</button>
                    </div>
                </div>
                <!-- ACTION BUTTONS -->
                <div class="d-flex gap-2">
                    <a id="btnAddCart"
                       asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Id"
                       class="btn btn-warning fw-bold flex-grow-1 py-2">
                        <i class="fa fa-cart-plus me-1"></i>Add to Cart
                    </a>
                    <a id="btnBuyNow"
                       asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Id"
                       class="btn btn-danger fw-bold flex-grow-1 py-2">
                        <i class="fa fa-bolt me-1"></i>Buy Now
                    </a>
                </div>
            }
            else
            {
                <button class="btn btn-secondary w-100 py-2" disabled>Out of Stock</button>
            }
        </div>
    </div>

    <!-- DELIVERY INFO -->
    <div class="col-md-3">
        <div class="white-card">
            <h6 class="fw-bold border-bottom pb-2 mb-3">Delivery & Services</h6>
            <div class="delivery-box">
                <div class="delivery-item">
                    <div class="delivery-icon">🚚</div>
                    <div><strong>Free Delivery</strong><small>On orders above Rs. 2,000</small></div>
                </div>
                <div class="delivery-item">
                    <div class="delivery-icon">💵</div>
                    <div><strong>Cash on Delivery</strong><small>Pay at your doorstep</small></div>
                </div>
                <div class="delivery-item">
                    <div class="delivery-icon">🔄</div>
                    <div><strong>7-Day Returns</strong><small>Hassle-free return policy</small></div>
                </div>
                
                <div class="delivery-item">
                    <div class="delivery-icon">📦</div>
                    <div><strong>Estimated Delivery</strong><small>3–5 working days</small></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- REVIEWS + RELATED -->
<div class="row mt-3 g-3">
    <div class="col-md-7">
        <div class="white-card">
            <h5 class="fw-bold border-bottom pb-2 mb-3">Customer Reviews (@Model.Reviews.Count)</h5>
            @if (!Model.Reviews.Any())
            {
                <p class="text-muted">No reviews yet. Be the first to review this product!</p>
            }
            else
            {
                @foreach (var r in Model.Reviews.Take(5))
                {
                    <div class="border-bottom py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@r.UserName</strong>
                            <span class="p-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa fa-star@(i <= r.Rating ? "" : "-o")"></i>
                                }
                            </span>
                        </div>
                        <p class="mb-0 mt-1 text-muted small">@r.Comment</p>
                    </div>
                }
            }
            <div class="mt-4">
                <h6 class="fw-bold">Write a Review</h6>
                <form asp-controller="Review" asp-action="Add" method="post">
                    <input type="hidden" name="ProductId" value="@Model.Id" />
                    <div class="mb-2">
                        <input name="UserName" class="form-control" placeholder="Your name" required />
                    </div>
                    <div class="mb-2">
                        <select name="Rating" class="form-control">
                            <option value="5">&#11088;&#11088;&#11088;&#11088;&#11088; 5 Stars - Excellent</option>
                            <option value="4">&#11088;&#11088;&#11088;&#11088; 4 Stars - Good</option>
                            <option value="3">&#11088;&#11088;&#11088; 3 Stars - Average</option>
                            <option value="2">&#11088;&#11088; 2 Stars - Poor</option>
                            <option value="1">&#11088; 1 Star - Very Bad</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <textarea name="Comment" class="form-control" rows="3"
                                  placeholder="Share your experience with this product..." required></textarea>
                    </div>
                    <button class="btn btn-warning fw-bold">Submit Review</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="white-card">
            <h5 class="fw-bold border-bottom pb-2 mb-3">Related Products</h5>
            @if (ViewBag.Related != null)
            {
                @foreach (ShopSphere.Models.Product r in ViewBag.Related)
                {
                    <div class="d-flex gap-3 mb-3 border-bottom pb-3">
                        <img src="@r.ImageUrl" style="width:60px;height:60px;object-fit:cover;border-radius:8px;"
                             onerror="this.src='https://via.placeholder.com/60?text=?'" />
                        <div class="flex-grow-1">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@r.Id"
                               class="text-decoration-none text-dark fw-semibold" style="font-size:12px;line-height:1.4;display:block;">@r.Name</a>
                            <div class="p-price" style="font-size:14px;margin-top:4px;">Rs. @r.Price.ToString("N0")</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeQty(delta) {
            var el = document.getElementById('qtyInput');
            var val = parseInt(el.value) + delta;
            var max = parseInt(el.max);
            if (val >= 1 && val <= max) {
                el.value = val;
                // Update both button links with quantity
                var base = '@Url.Action("AddToCart", "Cart")';
                var url = base + '?id=@Model.Id&quantity=' + val;
                document.getElementById('btnAddCart').href = url;
                document.getElementById('btnBuyNow').href = url;
            }
        }
        // Init links on page load
        document.addEventListener('DOMContentLoaded', function() {
            var url = '@Url.Action("AddToCart", "Cart")?id=@Model.Id&quantity=1';
            document.getElementById('btnAddCart').href = url;
            document.getElementById('btnBuyNow').href = url;
        });
    </script>
}

