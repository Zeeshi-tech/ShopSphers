@model ShopSphere.Models.Product

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="fw-bold mb-4">
            Add Product
        </h2>

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div class="mb-3">

                <label>Name</label>

                <input asp-for="Name"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label>Description</label>

                <textarea asp-for="Description"
                          class="form-control">
                </textarea>

            </div>

            <div class="mb-3">

                <label>Price</label>

                <input asp-for="Price"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label>Image</label>

                <input asp-for="ImageFile"
                       class="form-control" />

            </div>

            <button class="btn btn-success">
                Save Product
            </button>

        </form>

    </div>

</div>
