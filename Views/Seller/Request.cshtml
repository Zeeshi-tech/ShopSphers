@model IEnumerable<ShopSphere.Models.SellerRequest>

<div class="mt-5">

    <h2 class="fw-bold mb-4">

        Seller Requests

    </h2>

</div>

<div class="card shadow border-0 p-4">

    <table class="table">

        <thead>

            <tr>

                <th>Name</th>

                <th>Email</th>

                <th>Store</th>

                <th>Status</th>

                <th>Actions</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Name
                    </td>

                    <td>
                        @item.Email
                    </td>

                    <td>
                        @item.StoreName
                    </td>

                    <td>
                        @item.Status
                    </td>

                    <td>

                        <a asp-action="Approve"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">

                            Approve

                        </a>

                        <a asp-action="Reject"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">

                            Reject

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>